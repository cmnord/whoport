#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
usage: whoport <port>...

Show the process(es) listening on one or more TCP ports.

  whoport 3000              one port
  whoport 3000 8080 5432    several ports
EOF
}

case "${1:-}" in
  -h | --help) usage; exit 0 ;;
  "") usage >&2; exit 1 ;;
esac

rows=()

# `lsof` lists every open file on the system, with the following filters:
# -t		terse output: PIDs only, no header
# -nP		skip DNS resolution and service name lookups
# -iTCP:$port	only TCP sockets using this port (local or remote)
# -sTCP:LISTEN	only TCP sockets in listen state
for port in "$@"; do
  # one lsof per port so we know which port each PID belongs to
  pids=$(lsof -t -nP -iTCP:"$port" -sTCP:LISTEN || true)

  # PIDs are bare numbers, so word splitting is safe here
  for pid in $pids; do
    # `command` is the full command line; `comm` would be just the executable
    cmd=$(ps -o command= -p "$pid")

    rows+=("$(printf '%-6s %-8s %s' "$port" "$pid" "$cmd")")
  done
done

if [ ${#rows[@]} -eq 0 ]; then
  echo "nothing listening on: $*" >&2
  exit 1
fi

printf '%-6s %-8s %s\n' PORT PID COMMAND
printf '%s\n' "${rows[@]}"
